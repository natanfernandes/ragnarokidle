PORT=3001
HOST=0.0.0.0
# Longest offline period that is simulated when a player returns.
MAX_OFFLINE_HOURS=24

# Sprite renderer (zrenderer). Leave RENDERER_URL empty to use placeholder sprites.
RENDERER_URL=http://localhost:11011
RENDERER_TOKEN=
# Rendered sprites are cached here so each one is rendered only once.
ASSET_CACHE_DIR=.cache/sprites
