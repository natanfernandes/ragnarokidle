PORT=3001
HOST=0.0.0.0
# Longest offline period that is simulated when a player returns.
MAX_OFFLINE_HOURS=24

# Sprite renderer. Outside production, RENDERER_URL defaults to the free public
# ragassets instance (https://assets.latam-tools.com.br, best effort, no SLA).
# Set it to an empty value to use placeholder sprites instead.
RENDERER_KIND=ragassets
# RENDERER_URL=http://localhost:8080
# zrenderer instead:
# RENDERER_KIND=zrenderer
# RENDERER_URL=http://localhost:11011
# RENDERER_TOKEN=<access token printed on first start>

# Rendered sprites are cached here so each one is rendered only once.
ASSET_CACHE_DIR=.cache/sprites
